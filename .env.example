APP_NAME=NEXUS
APP_ENV=development
APP_DEBUG=false

API_VERSION=v1
API_PREFIX=/api/v1

POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus

DATABASE_URL=postgresql://nexus:nexus@postgres:5432/nexus
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
LLM_GATEWAY=litellm
LLM_ALLOWED_MODELS=["gpt-4o-mini"]

OTP_HMAC_SECRET=change-me-to-a-long-random-local-development-secret
SIGNUP_OTP_TTL_SECONDS=600
SIGNUP_OTP_MAX_ATTEMPTS=5
SIGNUP_OTP_LENGTH=6
SIGNUP_OTP_RATE_LIMIT_WINDOW_SECONDS=900
SIGNUP_OTP_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=no-reply@nexus.local
RESEND_API_KEY=

AUTH_TOKEN_SECRET=change-me-to-a-long-random-local-development-auth-token-secret
REFRESH_TOKEN_SECRET=change-me-to-a-long-random-local-development-refresh-token-secret
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
AUTH_TOKEN_ISSUER=nexus

CONVERSATION_HISTORY_LIMIT=50
CONVERSATION_HISTORY_MAX_CHARS=120000
CONVERSATION_MESSAGE_MAX_LENGTH=32000
FILE_UPLOAD_MAX_SIZE_BYTES=536870912
FILE_UPLOAD_GRANT_TTL_SECONDS=600
FILE_DOWNLOAD_GRANT_TTL_SECONDS=300
# DEVELOPMENT ONLY. Production must override through secret injection / Key Vault.
# URL-safe Base64 encoding of exactly 32 bytes for AES-256-GCM.
FILE_UPLOAD_CONTEXT_KEY=bmV4dXMtZGV2ZWxvcG1lbnQtdXBsb2FkLWtleS0wMDE

STORAGE_PROVIDER=azure_blob
AZURE_STORAGE_CONTAINER=nexus-files
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Production Azure Blob Storage (Managed Identity)
# AZURE_STORAGE_ACCOUNT_NAME=nexusstorage
# AZURE_STORAGE_ACCOUNT_URL=https://nexusstorage.blob.core.windows.net
# AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=

# File upload-completion worker (Managed Identity)
# AZURE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=nexus.servicebus.windows.net
# AZURE_SERVICE_BUS_QUEUE_NAME=file-upload-completions
# AZURE_SERVICE_BUS_MALWARE_SCAN_QUEUE_NAME=file-malware-scan-results
# AZURE_SERVICE_BUS_MANAGED_IDENTITY_CLIENT_ID=
# AZURE_EVENT_GRID_EXPECTED_SOURCE=/subscriptions/.../storageAccounts/nexusstorage
# AZURE_MALWARE_SCAN_EXPECTED_TOPIC=/subscriptions/.../providers/Microsoft.EventGrid/topics/nexus-file-malware-scan-results
# FILE_UPLOAD_COMPLETION_SOURCE=azure-primary
# FILE_MALWARE_SCAN_SOURCE=azure-defender-storage
# FILE_WORKER_MAX_LOCK_RENEWAL_SECONDS=300
# FILE_WORKER_DATABASE_POOL_SIZE=2
# FILE_WORKER_DATABASE_MAX_OVERFLOW=0
# The worker and API must receive the same FILE_UPLOAD_MAX_SIZE_BYTES value.

VITE_APP_NAME=NEXUS
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CONVERSATION_MODEL=gpt-4o-mini

CODEX_WORKER_ID=
GITHUB_REPOSITORY=summiya/nexus
GITHUB_PROJECT_NUMBER=1
GITHUB_TOKEN=
